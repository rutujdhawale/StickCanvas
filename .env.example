# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dodo Payments Configuration
# Mode: "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Server API Key (from Dodo Payments Dashboard -> Developers -> API Keys)
DODO_PAYMENTS_API_KEY=dodo_api_test_...

# Webhook Secret / Header Key (from Dodo Payments Dashboard -> Webhooks)
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...

# Dodo Product IDs (from Dodo Payments Dashboard -> Products)
# Single Sheet: $1.99 (one-time payment)
NEXT_PUBLIC_DODO_PRODUCT_SINGLE_SHEET=p_single_sheet_199
# 5-Sheet Pack: $4.99 (one-time payment, 5 credits)
NEXT_PUBLIC_DODO_PRODUCT_SHEET_PACK=p_sheet_pack_499
# Pro Creator: $7.99/month (subscription, unlimited credits)
NEXT_PUBLIC_DODO_PRODUCT_PRO_MONTHLY=p_pro_monthly_799

# Note: In development, if DODO_PAYMENTS_API_KEY is empty or 'dodo_api_test_...',
# StickerCanvas automatically simulates the Dodo checkout flow locally
# so you can test 300 DPI sheet unlocking and watermarked preview without active credentials!

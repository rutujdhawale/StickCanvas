# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Public Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (from Stripe Dashboard -> Products)
NEXT_PUBLIC_STRIPE_PRICE_SINGLE=price_single_sheet_...
NEXT_PUBLIC_STRIPE_PRICE_PACK=price_5pack_...
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_pro_monthly_...

# Stripe Secret Configuration (Server-only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Note: In development, if STRIPE_SECRET_KEY is empty or 'sk_test_...',
# StickerCanvas automatically simulates the Stripe Checkout flow locally
# so you can test 300 DPI sheet unlocking and watermarked preview without active credentials!
